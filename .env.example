# Physiology Settings
FTP=250
MAX_HR=185

# Server & Storage
DATA_DIR=/app/server
MCP_PORT=8050
SYNC_CRON_HOUR=2

# Strava API Credentials (optional if stored in server/.strava_tokens.json)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Tailscale Sidecar (Open WebUI node)
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=cycling-coach

# Open WebUI + Gemini
GEMINI_API_KEY=AIza...
WEBUI_SECRET_KEY=generate-a-random-32-char-string
