# Physiology Settings
FTP=250
MAX_HR=185

# Server & Storage
DATA_DIR=/app/server
MCP_PORT=8050
SYNC_CRON_HOUR=2
# Activity sync provider: auto, intervals, strava, or none
SYNC_SOURCE=auto

# Intervals.icu API Credentials (Settings -> Developer Settings -> API Key)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0

# Strava API Credentials (optional if stored in server/.strava_tokens.json)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Tailscale Sidecar (Open WebUI node)
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=cycling-coach

# Open WebUI + Gemini
GEMINI_API_KEY=AIza...
WEBUI_SECRET_KEY=generate-a-random-32-char-string

# Optional Local LAN IP (macvlan for ts-cycling-coach / open-webui)
LAN_PARENT_IFACE=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_IP=192.168.1.250
